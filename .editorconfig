# EditorConfig is awesome: https://editorconfig.org
# Matches the WordPress coding standards: https://developer.wordpress.org/coding-standards/wordpress-coding-standards/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{php,js,css,scss}]
indent_style = tab
indent_size = 4
