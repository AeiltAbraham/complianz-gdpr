<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	cacheResult="false"
	>
	<testsuites>
		<!-- Live-WP tests in tests/ (prefix test-, suffix .php), bootstrapped by
		     tests/bootstrap.php against the WordPress test library. Provision it with
		     bin/install-wp-tests.sh; see docs/developers/testing.md. -->
		<testsuite name="complianz">
			<directory prefix="test-" suffix=".php">./tests/</directory>
		</testsuite>
	</testsuites>
	<!-- Network-dependent tests are tagged @group external-http (WordPress core's own
	     convention) and excluded from the default run here; the composer test script
	     excludes the same group. Run them explicitly by selecting the external-http group
	     on the command line. -->
	<groups>
		<exclude>
			<group>external-http</group>
		</exclude>
	</groups>
</phpunit>
